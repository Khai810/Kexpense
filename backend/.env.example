ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Kexpense API"
API_V1_STR="/api/v1"
SECRET_KEY="kexpense-dev-secret-key-at-least-32-characters-long"

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kexpense
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/kexpense

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/uploads

GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.0-flash

CORS_ORIGINS=["http://localhost:3000"]
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
