# Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true

# Backend Settings
PROJECT_NAME="Kexpense"
API_V1_STR="/api/v1"
SECRET_KEY="kexpense-dev-secret-key-at-least-32-characters-long"

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kexpense
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kexpense
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/kexpense

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/uploads

# AI Providers
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.0-flash

# Security & CORS
CORS_ORIGINS=["http://localhost:3000"]
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
